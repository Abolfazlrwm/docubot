# Copy to .env for local development: cp .env.example .env
# Everything runs offline by default (fake LLM + local embeddings only need
# the ~220 MB model download on first document). No API keys required.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me-before-any-real-deployment-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (service name "db" in docker compose)
POSTGRES_DB=docubot
POSTGRES_USER=docubot
POSTGRES_PASSWORD=docubot
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (cache + Celery broker/results)
REDIS_URL=redis://redis:6379/0

# Celery
# True runs tasks synchronously (tests, quick demos without a worker)
CELERY_TASK_ALWAYS_EAGER=False

# Uploads (bytes)
MAX_UPLOAD_SIZE=10485760

# Document processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Embeddings: local (fastembed, ~220 MB first download) | fake (offline) | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=/home/appuser/.cache/fastembed
# Only used when EMBEDDING_PROVIDER=openai
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=

# LLM for RAG answers: fake (offline, default) | openai (any OpenAI-compatible
# endpoint: OpenAI, Azure, Ollama, vLLM, OpenRouter...) | anthropic
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024

# RAG behaviour
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.3
CHAT_HISTORY_MESSAGES=6

# Retrieval signals: "vector" (embeddings), "keyword" (Postgres FTS), "hybrid" (both, RRF-fused)
#   SEARCH_MODE    -> default for POST /api/v1/search/
#   RETRIEVAL_MODE -> default for RAG answers (recall matters most there)
SEARCH_MODE=vector
RETRIEVAL_MODE=hybrid
# Postgres text-search config; "simple" behaves uniformly across languages
FTS_CONFIG=simple
# Hybrid fusion: candidates fetched per signal, and the RRF damping constant
HYBRID_CANDIDATE_MULTIPLIER=3
HYBRID_RRF_K=60

# Follow-up questions are rewritten into standalone search queries (best effort)
QUERY_REWRITE_ENABLED=1
REWRITE_MAX_CHARS=400
QUERY_REWRITE_MAX_HISTORY=6

# Streaming (SSE): characters per flushed chunk for fallback/fake streaming
STREAM_CHUNK_SIZE=24

# Rate limits (DRF throttle rates; tune per environment)
THROTTLE_AUTH=30/min
THROTTLE_CHAT=60/min
THROTTLE_SEARCH=60/min
THROTTLE_UPLOAD=60/hour
# Per-minute budget for personal API keys (a key may override its own budget)
APIKEY_RATE_LIMIT=120
