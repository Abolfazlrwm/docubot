# Copy to .env for local development: cp .env.example .env

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me-before-any-real-deployment-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres
POSTGRES_DB=docubot
POSTGRES_USER=docubot
POSTGRES_PASSWORD=docubot
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery (broker/results default to REDIS_URL)
CELERY_TASK_ALWAYS_EAGER=False

# Uploads (bytes)
MAX_UPLOAD_SIZE=10485760

# Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=/home/appuser/.cache/fastembed

# OpenAI-compatible provider (only used when EMBEDDING_PROVIDER=openai)
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=
